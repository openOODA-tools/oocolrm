// # oocolrm Command Line Options Parser
//
// Logline: Parses command-line column arguments, tab expansion flags, and MCP switches.
//
// Setup: Decodes POSIX positional arguments and GNU-style long switches with zero ambient authority.
//
// Beats:
//   1. Declare ColrmCliOpts structure encapsulating column limits and modes.
//   2. Parse positional numeric bounds and file paths.
//   3. Parse flags for tabs, replacement characters, inversion, and demo.
//   4. Supply initialized default option records.

import "ipc/json_field.oo";

pub type ColrmCliOpts = struct {
    start: Int,
    stop: Int,
    file_path: String,
    expand_tabs: Bool,
    tab_width: Int,
    replace_char: String,
    invert: Bool,
    inspect: Bool,
    demo: Bool,
    json: Bool,
    mcp: Bool,
    help: Bool,
    version: Bool
};

pub fn make_default_cli_opts() -> ColrmCliOpts {
    return ColrmCliOpts {
        start: 0,
        stop: 0,
        file_path: "",
        expand_tabs: false,
        tab_width: 8,
        replace_char: "",
        invert: false,
        inspect: false,
        demo: false,
        json: false,
        mcp: false,
        help: false,
        version: false
    };
}

fn is_numeric_arg(s: String) -> Bool {
    let n: Int = chars_len(s);
    if n == 0 { return false; }
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if b < 48 || b > 57 { return false; }
        i = i + 1;
    }
    return true;
}

pub fn parse_cli_args(args: List[String]) -> ColrmCliOpts {
    let mut opts: ColrmCliOpts = make_default_cli_opts();
    let num_args: Int = list_len(args);
    let mut i: Int = 0;
    let mut pos_count: Int = 0;

    while i < num_args {
        let arg: String = list_get(args, i);

        if arg == "-h" || arg == "--help" {
            opts.help = true;
        } else if arg == "-V" || arg == "--version" {
            opts.version = true;
        } else if arg == "--mcp" {
            opts.mcp = true;
        } else if arg == "--demo" {
            opts.demo = true;
        } else if arg == "--json" {
            opts.json = true;
        } else if arg == "--inspect" {
            opts.inspect = true;
        } else if arg == "-x" || arg == "--expand-tabs" {
            opts.expand_tabs = true;
        } else if arg == "-v" || arg == "--invert" {
            opts.invert = true;
        } else if arg == "-s" || arg == "--start" {
            if i + 1 < num_args {
                i = i + 1;
                opts.start = parse_int(list_get(args, i), 0);
            }
        } else if arg == "-e" || arg == "--stop" {
            if i + 1 < num_args {
                i = i + 1;
                opts.stop = parse_int(list_get(args, i), 0);
            }
        } else if arg == "-t" || arg == "--tab" || arg == "--tab-width" {
            opts.expand_tabs = true;
            if i + 1 < num_args {
                i = i + 1;
                opts.tab_width = parse_int(list_get(args, i), 8);
            }
        } else if arg == "-r" || arg == "--replace" {
            if i + 1 < num_args {
                i = i + 1;
                opts.replace_char = list_get(args, i);
            }
        } else if !str_starts_with(arg, "-") {
            if is_numeric_arg(arg) {
                if pos_count == 0 {
                    opts.start = parse_int(arg, 0);
                    pos_count = 1;
                } else if pos_count == 1 {
                    opts.stop = parse_int(arg, 0);
                    pos_count = 2;
                } else if chars_len(opts.file_path) == 0 {
                    opts.file_path = arg;
                }
            } else if chars_len(opts.file_path) == 0 {
                opts.file_path = arg;
            }
        }

        i = i + 1;
    }

    return opts;
}
